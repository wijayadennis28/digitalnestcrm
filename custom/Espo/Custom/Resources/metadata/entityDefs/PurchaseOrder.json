{
    "collection": {
        "orderBy": "createdAt",
        "order": "desc",
        "textFilterFields": [
            "name",
            "number",
            "id"
        ],
        "fullTextSearch": false,
        "countDisabled": false
    },
    "optimisticConcurrencyControl": false,
    "fields": {
        "cDueDateForPaymentToSupplier": {
            "notNull": false,
            "type": "date",
            "default": "javascript: return this.dateTime.getToday();",
            "isCustom": true
        },
        "deliveryDate": {
            "default": "javascript: return this.dateTime.getToday();"
        },
        "supplier": {
            "createButton": true,
            "audited": true
        },
        "billingContact": {
            "createButton": true,
            "autocompleteOnEmpty": true
        },
        "shippingContact": {
            "createButton": true,
            "autocompleteOnEmpty": true
        },
        "name": {
            "options": []
        },
        "status": {
            "options": [
                "Draft",
                "Canceled",
                "Pending Received Inventory",
                "Wating for Payment",
                "Released",
                "Completed"
            ],
            "style": {
                "Draft": null,
                "Canceled": "info",
                "Pending Received Inventory": "processed",
                "Wating for Payment": "waitingpayment",
                "Released": "primary",
                "Completed": "success"
            }
        },
        "cTermOfPayment": {
            "type": "varchar",
            "maxLength": 100,
            "options": [],
            "isCustom": true
        },
        "numberA": {
            "prefix": "PO2025-",
            "padLength": 4,
            "nextNumber": 1
        }
    }
}